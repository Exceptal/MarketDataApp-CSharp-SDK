<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarketData</RootNamespace>
    <AssemblyName>MarketData</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <Version>0.1.0</Version>
    <Authors>Exceptal</Authors>
    <Description>C#/.NET SDK for the MarketData.app API. Provides asynchronous access to real-time and historical financial data including stocks, options, funds, and market status.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Exceptal/MarketDataApp-CSharp-SDK</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Exceptal/MarketDataApp-CSharp-SDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>finance;market-data;stocks;options;api;marketdata</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>

    <!-- Symbols package (snupkg) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Reproducible / deterministic builds -->
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Package validation — checks API surface consistency for net10.0 -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Include the repository README as the NuGet package readme -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <!-- Source Link: embeds source file URIs in the PDB for debugger step-through -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
